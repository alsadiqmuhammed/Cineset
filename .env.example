NODE_ENV=production
PORT=3000
# Required in production: 32+ random characters, e.g. `openssl rand -hex 32`.
# The server refuses to start in production without it.
CINESET_SECRET=
MAX_UPLOAD_MB=500
APP_BASE_URL=https://your-domain.example

# Where the JSON database and uploads live (point at a persistent disk in production)
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Demo accounts (creator@/client@cineset.local) are only created and usable outside
# production. Set to true to force them on, false to force them off.
CINESET_SEED_DEMO=

# Managed PostgreSQL / Supabase (integration placeholder)
DATABASE_URL=

# Object storage such as Cloudflare R2 / S3 (integration placeholder)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Transactional email / SMTP (integration placeholder)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI provider (integration placeholder)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
