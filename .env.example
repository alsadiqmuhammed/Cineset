NODE_ENV=production
PORT=3000
# Required in production: 32+ random characters, e.g. `openssl rand -hex 32`.
# The server refuses to start in production without it.
CINESET_SECRET=
MAX_UPLOAD_MB=500
# Public address of the app. Used for links in emails.
APP_BASE_URL=https://your-domain.example

# Local fallback storage (used when DATABASE_URL / STORAGE_BUCKET are empty)
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Demo accounts (creator@/client@cineset.local) are only created and usable outside
# production. Set to true to force them on, false to force them off.
CINESET_SEED_DEMO=

# --- PostgreSQL (Supabase, Neon, Render, Railway, RDS...) ---
# Leave empty to use the local JSON file. On first start against an empty database,
# existing data from DATA_DIR/db.json is imported automatically.
DATABASE_URL=
# Set to no-verify only if your provider's certificate can't be verified (some poolers).
DATABASE_SSL=

# --- Object storage, S3-compatible (Cloudflare R2, AWS S3, Backblaze B2...) ---
# Leave STORAGE_BUCKET empty to keep uploads on local disk.
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com  (region: auto)
# AWS: leave STORAGE_ENDPOINT empty and set STORAGE_REGION (e.g. eu-central-1)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Email over SMTP (Resend, Postmark, SendGrid, Mailgun, SES...) ---
# Leave SMTP_HOST empty to disable email. Port 465 uses TLS directly; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CINESET <no-reply@your-domain.example>"
# Set to false to only email invites, not every notification.
EMAIL_NOTIFICATIONS=

# --- AI production plans (Claude, by Anthropic) ---
# Leave AI_API_KEY empty to use the built-in template. Get a key at https://console.anthropic.com
AI_PROVIDER=anthropic
AI_API_KEY=
# Defaults to claude-opus-5-5.
AI_MODEL=
# Per-user limit, to keep API costs in check.
AI_REQUESTS_PER_HOUR=20
