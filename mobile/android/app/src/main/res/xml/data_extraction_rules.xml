<?xml version="1.0" encoding="utf-8"?>
<!-- App data stays on the device; people use the in-app backup instead of cloud backup. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" /></cloud-backup>
    <device-transfer><include domain="root" /><include domain="file" /><include domain="database" /><include domain="sharedpref" /></device-transfer>
</data-extraction-rules>
